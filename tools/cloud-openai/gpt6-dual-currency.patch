diff --git a/tests/quota-currency.test.cjs b/tests/quota-currency.test.cjs
new file mode 100644
index 0000000..73826d7
--- /dev/null
+++ b/tests/quota-currency.test.cjs
@@ -0,0 +1,96 @@
+'use strict'
+
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const path = require('node:path')
+const test = require('node:test')
+const { build } = require('esbuild')
+
+test('mixed-currency requests reserve and report each historical wallet independently', async () => {
+  const source = path.resolve(__dirname, '..')
+  const { SqliteD1 } = await import('../runtime/sqlite-d1.mjs')
+  const database = new SqliteD1(':memory:')
+  const sql = database.database
+  const migrations = path.join(source, 'drizzle')
+  for (const name of fs.readdirSync(migrations).filter(name => /^\d{4}_.+\.sql$/.test(name)).sort()) {
+    sql.exec(fs.readFileSync(path.join(migrations, name), 'utf8'))
+  }
+  const bundled = await build({
+    entryPoints: [path.join(source, 'lib/server/quota.ts')],
+    tsconfig: path.join(source, 'tsconfig.json'),
+    bundle: true,
+    platform: 'node',
+    format: 'cjs',
+    write: false,
+    plugins: [{ name: 'in-memory-d1', setup(builder) {
+      builder.onResolve({ filter: /^\.\/env$/ }, () => ({ path: 'fixture-env', namespace: 'quota-test' }))
+      builder.onLoad({ filter: /.*/, namespace: 'quota-test' }, () => ({ contents: 'export async function getD1() { return globalThis.__quotaCurrencyTestDb }' }))
+    } }],
+  })
+  const quotaModule = { exports: {} }
+  new Function('module', 'exports', 'require', bundled.outputFiles[0].text)(quotaModule, quotaModule.exports, require)
+  const { reserveRequest, getUsageSummary, getAdminUsageOverview } = quotaModule.exports
+  globalThis.__quotaCurrencyTestDb = database
+  const now = Date.now()
+  try {
+    sql.exec(`INSERT INTO accounts (id, username, display_name, password_algorithm, password_hash, password_salt, password_iterations, created_at, updated_at)
+      VALUES ('a','tester','Tester','pbkdf2-sha256','hash','salt',100000,1,1),
+        ('b','cny_only','CNY only','pbkdf2-sha256','hash','salt',100000,1,1);
+      INSERT INTO models(id,display_name,provider,upstream_model,upstream_base_url,secret_name,context_window,max_output_tokens,status,created_at,updated_at)
+      VALUES('gpt-6.1-sol','GPT-6.1 Sol','openai','gpt-6.1-sol','https://api.openai.com/v1','OPENAI_API_KEY',1050000,128000,'active',1,1);
+      INSERT INTO model_prices(id,model_id,currency,input_micros_per_million,output_micros_per_million,effective_at,created_at)
+      VALUES('price-cny','gpt-6.1-sol','CNY',1,1,0,1),('price-usd','gpt-6.1-sol','USD',1,1,1,1);`)
+    const wallet = sql.prepare(`INSERT INTO quota_buckets (id,account_id,currency,limit_micros,period_start,period_end,created_at,updated_at)
+      VALUES (?, ?, ?, 1000, ?, ?, ?, ?)`)
+    for (const [id, account, currency] of [['cny', 'a', 'CNY'], ['usd', 'a', 'USD'], ['other', 'b', 'CNY']]) {
+      wallet.run(id, account, currency, now - 60_000, now + 60_000, now, now)
+    }
+    const reserve = (account, currency, key) => reserveRequest({
+      auth: { account: { id: account } },
+      model: { id: 'gpt-6.1-sol', priceVersionId: `price-${currency.toLowerCase()}`, currency, pricingAt: now },
+      body: { input: 'synthetic' },
+      idempotencyKey: key,
+      estimate: { reservedMicros: 100, maxOutputTokens: 20 },
+    })
+    const cny = await reserve('a', 'CNY', 'request-cny-1')
+    const usd = await reserve('a', 'USD', 'request-usd-1')
+    const disputed = await reserve('a', 'USD', 'request-usd-2')
+    assert.equal(cny.quotaBucketId, 'cny')
+    assert.equal(usd.quotaBucketId, 'usd')
+    assert.equal(disputed.quotaBucketId, 'usd')
+    await assert.rejects(reserve('b', 'USD', 'request-usd-3'), err => err.status === 429 && /USD/.test(err.message))
+    assert.equal(sql.prepare("SELECT reserved_micros FROM quota_buckets WHERE id='other'").get().reserved_micros, 0)
+    sql.exec("UPDATE gateway_requests SET state='inflight' WHERE state='reserved'")
+    const settle = sql.prepare("UPDATE gateway_requests SET state='settled',actual_micros=?,prompt_tokens=?,completion_tokens=? WHERE id=?")
+    settle.run(12, 3, 7, cny.id)
+    settle.run(3, 8, 2, usd.id)
+    sql.prepare("UPDATE gateway_requests SET state='uncertain',actual_micros=100 WHERE id=?").run(disputed.id)
+
+    const expected = [
+      { currency: 'CNY', confirmed_micros: 12, uncertain_micros: 0, actual_micros: 12 },
+      { currency: 'USD', confirmed_micros: 3, uncertain_micros: 100, actual_micros: 103 },
+    ]
+    const summary = await getUsageSummary('a', now, Date.now() + 1)
+    assert.deepEqual(summary.byCurrency, expected)
+    assert.equal(summary.totals.request_count, 3)
+    assert.equal(summary.totals.prompt_tokens, 11)
+    assert.equal(summary.totals.completion_tokens, 9)
+    assert.equal(summary.totals.actual_micros, 12)
+    assert.equal(summary.totals.uncertain_micros, 0)
+    assert.deepEqual(summary.byModel.map(({ model_id, currency, actual_micros }) => [model_id, currency, actual_micros]), [
+      ['gpt-6.1-sol', 'CNY', 12], ['gpt-6.1-sol', 'USD', 103],
+    ])
+    const admin = await getAdminUsageOverview(now, Date.now() + 1)
+    assert.deepEqual(admin.byCurrency, expected)
+    assert.equal(admin.totals.actual_micros, 12)
+    assert.equal(admin.byAccount.find(row => row.account_id === 'a').actual_micros, 12)
+    assert.equal(admin.byModel[0].actual_micros, 12)
+    assert.equal(admin.byModel[0].request_count, 3)
+    const empty = await getUsageSummary('b', now, Date.now() + 1)
+    assert.deepEqual(empty.byCurrency, [])
+    assert.equal(empty.totals.actual_micros, 0)
+  } finally {
+    delete globalThis.__quotaCurrencyTestDb
+    database.close()
+  }
+})
