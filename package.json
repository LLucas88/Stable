{
  "name": "stable-desktop",
  "version": "1.0.2",
  "description": "Stable local agent workbench powered by Claude Agent SDK",
  "main": "desktop/main.cjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "start:team-dev": "node scripts/start-team-dev.cjs",
    "build": "vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "pretest": "node node_modules/electron/install.js",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:feature-v2": "node --test tests/skill-selection.test.cjs tests/manual-skills-ui.test.cjs tests/prompts.test.cjs tests/conversation-state.test.cjs tests/project-ipc.test.cjs tests/project-controls-ui.test.cjs tests/sidebar-controls-ui.test.cjs tests/feature-v2-services.test.cjs tests/browser-downloads.test.cjs tests/shared-browser.test.cjs tests/claude-lifecycle.test.cjs tests/conversation-tools-ui.test.cjs tests/skill-market-ui.test.cjs tests/claude-harness.test.cjs tests/tool-approval.test.cjs tests/claude-tools.test.cjs tests/agent-steer-ipc.test.cjs tests/store.test.cjs tests/catch-and-conversation-tools.test.cjs tests/file-location.test.cjs tests/model-switching-ui.test.cjs tests/navigation-workspace-ui.test.cjs tests/feature-v2-startup.test.cjs",
    "test:clarification": "node --test tests/clarification.test.cjs tests/clarification-ipc.test.cjs tests/clarification-interaction.test.cjs tests/clarification-card-ui.test.cjs tests/clarification-agent-page-ui.test.cjs tests/message-outbox.test.cjs",
    "test:integration": "node --test --test-concurrency=1 tests/claude-sdk-integration.cjs",
    "test:claude-integration": "node --test --test-concurrency=1 tests/claude-sdk-integration.cjs",
    "runtime:powershell": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-powershell-runtime.ps1",
    "runtime:archive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-runtime.ps1",
    "tools:install": "npm ci --prefix vendor/agent-tools --ignore-scripts --no-audit --no-fund",
    "tools:verify": "node scripts/verify-builtin-tools.cjs",
    "dist:dir": "npm run runtime:powershell && npm run python:verify && npm run tools:verify && npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run runtime:powershell && npm run python:verify && npm run tools:verify && npm run build && electron-builder --win --x64",
    "dist:update": "npm run runtime:powershell && npm run python:verify && npm run tools:verify && electron-builder --config build/update-builder.config.cjs --win --x64 --publish never",
    "python:install": "uv pip install --target vendor/wending-cli/python/Lib/site-packages -r scripts/python-requirements.txt",
    "python:verify": "node scripts/verify-python-tools.cjs",
    "sandbox:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-wsl-sandbox.ps1",
    "test:wsl-integration": "node --test tests/wsl-sandbox-integration.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@xyflow/react": "^12.8.6",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.1",
    "pdf-parse": "1.1.1",
    "pptxgenjs": "4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.stable.agent",
    "productName": "Stable",
    "asar": true,
    "beforePack": "scripts/verify-builtin-tools.cjs",
    "compression": "normal",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "build/stable_logo.png",
      "build/stable_logo_transparent.png",
      "build/stable_app_icon.png",
      "package.json",
      "!desktop/skills/filtered/bundle/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-win32-*/claude.exe"
    ],
    "extraResources": [
      {
        "from": "vendor/agent-tools",
        "to": "agent-tools",
        "filter": [
          "package.json",
          "package-lock.json",
          "README.md"
        ]
      },
      {
        "from": "vendor/agent-tools/node_modules",
        "to": "agent-tools/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "node/**/*",
          "powershell/**/*"
        ]
      },
      {
        "from": "vendor/wending-cli",
        "to": "wending-cli"
      },
      {
        "from": "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/claude.exe",
        "to": "claude/claude.exe"
      },
      {
        "from": "vendor/wsl-agent",
        "to": "wsl-agent",
        "filter": [
          "package.json",
          "package-lock.json",
          "runner.cjs",
          "workspace-copy.cjs"
        ]
      },
      {
        "from": "scripts",
        "to": "wsl-setup",
        "filter": [
          "setup-wsl-sandbox.ps1",
          "setup-wsl-sandbox.sh"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release-1.0.2"
    },
    "win": {
      "icon": "build/stable_app_icon.png",
      "artifactName": "Stable-Setup-1.0.02-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "script": "build/installer.nsi",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "useZip": false,
      "differentialPackage": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stable",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LLucas88",
        "repo": "Stable",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/copy-bundled-skills.cjs"
  },
  "releaseVersion": "1.0.02"
}
